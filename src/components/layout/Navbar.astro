---
import { Icon } from 'astro-icon/components';
import { getLocale, localizedPath, otherLocale } from '@lib/i18n/utils';
import { pick, type I18nField } from '@lib/sanity/i18n';
import { copy } from '@lib/content/siteCopy';

interface Props {
    settings: Record<string, I18nField | string> | null;
}

const { settings } = Astro.props;
const locale = getLocale(Astro.url);
const other = otherLocale(locale);
const path = Astro.url.pathname;

const t = (key: string) => pick(settings?.[key] as I18nField, locale);
const membersUrl = (settings?.membersUrl as string) || '#';
const bookingUrl = (settings?.bookingUrl as string) || '#';

/** The two service pages, hung under "Nos services" in both menus. */
const serviceChildren = [
    {
        label: copy(settings, 'navServicesEntreprises', locale),
        href: localizedPath('/services/entreprises', locale)
    },
    {
        label: copy(settings, 'navServicesLeaders', locale),
        href: localizedPath('/services/leaders', locale)
    }
];

const links = [
    { label: t('navAbout'), href: localizedPath('/about', locale) },
    {
        label: t('navPrograms'),
        href: localizedPath('/services', locale),
        children: serviceChildren
    },
    { label: t('navMembers'), href: membersUrl, external: true },
    { label: t('navContact'), href: localizedPath('/contact', locale) },
    { label: t('navIam'), href: localizedPath('/centre-iam', locale) }
];

/**
 * The mobile menu is its own running order, not the desktop bar restacked: it
 * hangs the two service pages under "Nos services" as indented sub-links and
 * ends on the booking CTA, then the language toggle. Matches MOB-Header_Menu.
 */
const menuLinks = [
    { label: t('navAbout'), href: localizedPath('/about', locale) },
    {
        label: t('navPrograms'),
        href: localizedPath('/services', locale),
        children: serviceChildren
    },
    { label: t('navIam'), href: localizedPath('/centre-iam', locale) },
    { label: t('navMembers'), href: membersUrl, external: true },
    { label: t('navContact'), href: localizedPath('/contact', locale) },
    { label: t('navBook'), href: bookingUrl, external: true }
];
---

<nav-bar style="display: contents;">
    <!-- `top-16` is the 64px the mobile frames float the bar below the top edge;
         the desktop offset takes over at `md`. -->
    <div
        id="navbar"
        class="fixed top-16 z-50 flex h-fit w-full flex-row items-center justify-between bg-yellow px-page py-[0.3125rem] md:top-main-40 md:py-main-5"
    >
        <a href={localizedPath('/', locale)} class="relative z-10">
            <Icon name="logo" class="h-[1.875rem] w-auto md:h-main-logo" />
        </a>

        <!-- Desktop nav items -->
        <div
            class="desktop-nav flex flex-row items-center gap-main-40 font-sans text-main-section tracking-[2%] uppercase"
        >
            {
                links.map((link) =>
                    link.children ? (
                        /* "Nos services" carries the hover dropdown. The panel is a
                           child of this wrapper so that moving into it still counts
                           as hovering the parent. */
                        <div class="nav-dropdown-wrap">
                            <a class="hover-underline" href={link.href}>
                                {link.label}
                            </a>
                            <div class="nav-dropdown">
                                <div class="nav-dropdown-panel bg-perle">
                                    {link.children.map((child) => (
                                        <a class="nav-dropdown-item" href={child.href}>
                                            <span class="hover-underline">{child.label}</span>
                                        </a>
                                    ))}
                                </div>
                            </div>
                        </div>
                    ) : (
                        <a
                            class="hover-underline"
                            href={link.href}
                            target={link.external ? '_blank' : undefined}
                        >
                            {link.label}
                        </a>
                    )
                )
            }
        </div>
        <div
            class="desktop-nav flex flex-row items-center gap-main-40 font-sans text-main-section tracking-[2%] uppercase"
        >
            <a href={localizedPath(path, other)} class="hover-underline">{other.toUpperCase()}</a>
            <a class="hover-underline" href={bookingUrl} target="_blank">{t('navBook')}</a>
        </div>

        <!-- Hamburger button (mobile only) -->
        <button id="hamburger" class="hamburger" aria-label="Toggle menu" aria-expanded="false">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
    </div>

    <!-- Mobile menu overlay. Sits under the bar rather than replacing it, so the
         logo and burger never move as it opens. -->
    <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
        <nav class="mobile-nav gap-0 px-mob-16 pt-mob-64 pb-mob-32">
            {
                menuLinks.map((link) => (
                    <div class="flex w-full flex-col border-t border-white">
                        <a
                            href={link.href}
                            target={link.external ? '_blank' : undefined}
                            class:list={[
                                'w-full px-mob-inset pt-[1.5rem] text-mob-md leading-[1.2]',
                                /* The sub-links sit tight under their parent, so
                                    that space is the wrapper's gap alone — the
                                   link gives up its own bottom padding or the
                                   two would stack. Items without children keep
                                   the full 32px, and the gap does nothing to
                                   them. */
                                link.children ? 'pb-0' : 'pb-[1.25rem]'
                            ]}
                        >
                            {link.label}
                        </a>
                        {link.children && (
                            <div class="flex flex-col gap-mob-16 pt-mob-16 pb-[1.5rem] pl-[calc(var(--spacing-mob-inset)+var(--spacing-mob-32))]">
                                {link.children.map((child) => (
                                    <a href={child.href} class="text-mob-sub leading-[120%]">
                                        {child.label}
                                    </a>
                                ))}
                            </div>
                        )}
                    </div>
                ))
            }
            <a
                href={localizedPath(path, other)}
                class="w-full px-mob-inset pt-mob-32 text-mob-sub leading-[120%] uppercase"
                >{other.toUpperCase()}</a
            >
        </nav>
    </div>
</nav-bar>

<style>
    /* The 3.5px the frame keeps between the panel edge and its labels. Pulling
       the panel left by the same amount lands its type on the same vertical as
       "Nos services" above it. */
    .nav-dropdown-wrap {
        --dropdown-inset: 0.21875rem;
        position: relative;
    }

    /* The panel hangs off the bar's bottom edge, not the link's. The link is
       centred in the bar, so that drop is half the bar's height — the logo,
       which is its tallest child, plus the `py-main-5` band on each side. It is
       transparent padding rather than an offset so the pointer never crosses a
       dead gap on its way down into the panel and closes it. */
    .nav-dropdown {
        position: absolute;
        top: 50%;
        left: calc(-1 * var(--dropdown-inset));
        padding-top: calc((var(--spacing-main-logo) + 2 * var(--spacing-main-5)) / 2);
        opacity: 0;
        margin-left: calc(var(--spacing-main-5) * -1);
        visibility: hidden;
        transition:
            opacity var(--transition-duration-fast) var(--ease-power3-out),
            visibility 0s linear var(--transition-duration-fast);
    }

    .nav-dropdown-panel {
        display: flex;
        width: max-content;
        flex-direction: column;

        padding-inline: var(--dropdown-inset);
    }

    .nav-dropdown-item {
        display: block;
        padding-block: var(--spacing-main-5);
        padding-right: 1.25rem;
        padding-top: var(--spacing-main-5);
        padding-bottom: var(--spacing-main-5);
        padding-left: var(--spacing-main-5);
    }

    .nav-dropdown-wrap:focus-within .nav-dropdown {
        opacity: 1;
        visibility: visible;
        transition-delay: 0s;
    }

    @media (hover: hover) {
        .nav-dropdown-wrap:hover .nav-dropdown {
            opacity: 1;
            visibility: visible;
            transition-delay: 0s;
        }

        /* The parent stays underlined for as long as the panel is open, even
           once the pointer has left the link itself. */
        .nav-dropdown-wrap:hover > .hover-underline {
            background-position: 0% 100%;
            background-size: 100% max(1px, 0.04em);
        }
    }

    .hamburger {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        width: 30px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        position: relative;
        z-index: 200;
    }

    .bar {
        display: block;
        width: 30px;
        height: 1px;
        background-color: black;
        transition:
            transform 0.35s cubic-bezier(0.77, 0, 0.175, 1),
            opacity 0.25s ease;
        transform-origin: center;
    }

    .hamburger.is-open .bar:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
    }
    .hamburger.is-open .bar:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }
    .hamburger.is-open .bar:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
    }

    .mobile-menu {
        position: fixed;
        inset: 0;
        background-color: var(--color-yellow);
        z-index: 40;
        display: flex;
        align-items: start;
        justify-content: start;
        /* Clears the bar: it floats 64px down and is 40px tall, so nothing can
           start above 104px. The nav's own `pt-mob-64` opens the gap below it. */
        padding-top: 6.5rem;
        overflow-x: hidden;
        overflow-y: auto;
        opacity: 0;
        pointer-events: none;
        transform: translateY(-8px);
        transition:
            opacity 0.35s cubic-bezier(0.77, 0, 0.175, 1),
            transform 0.35s cubic-bezier(0.77, 0, 0.175, 1);
    }

    .mobile-menu.is-open {
        opacity: 1;
        pointer-events: all;
        transform: translateY(0);
    }

    .mobile-nav {
        display: flex;
        width: 100%;
        flex-direction: column;
        align-items: start;
    }

    .mobile-nav a {
        font-family: var(--font-sans, sans-serif);
        letter-spacing: 0%;
        line-height: 105%;
        color: black;
        text-decoration: none;
        position: relative;
    }

    /* Deliberately *not* the 810px the rest of the site switches at: the bar
       carries seven links plus the language toggle, and they crowd well before
       the layout does. The nav is the one thing allowed its own threshold. */
    @media (max-width: 1024px) {
        .desktop-nav {
            display: none;
        }
        .hamburger {
            display: flex;
        }
    }
</style>

<script>
    class NavBar extends HTMLElement {
        connectedCallback() {
            const hamburger = this.querySelector('#hamburger');
            const mobileMenu = this.querySelector('#mobile-menu');

            if (!hamburger || !mobileMenu) return;

            mobileMenu.addEventListener(
                'wheel',
                (e) => {
                    e.preventDefault();
                    mobileMenu.scrollTop += (e as WheelEvent).deltaY;
                },
                { passive: false }
            );

            hamburger.addEventListener('click', () => {
                const isOpen = hamburger.classList.toggle('is-open');
                mobileMenu.classList.toggle('is-open', isOpen);
                hamburger.setAttribute('aria-expanded', String(isOpen));
                mobileMenu.setAttribute('aria-hidden', String(!isOpen));
                document.body.style.overflow = isOpen ? 'hidden' : '';
            });

            mobileMenu.querySelectorAll('a').forEach((link) => {
                link.addEventListener('click', () => {
                    hamburger.classList.remove('is-open');
                    mobileMenu.classList.remove('is-open');
                    hamburger.setAttribute('aria-expanded', 'false');
                    mobileMenu.setAttribute('aria-hidden', 'true');
                    document.body.style.overflow = '';
                });
            });
        }
    }

    if (!customElements.get('nav-bar')) {
        customElements.define('nav-bar', NavBar);
    }
</script>
