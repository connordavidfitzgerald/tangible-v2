---
import BaseLayout from '@layouts/BaseLayout.astro';
import SanityPicture from '@components/ui/SanityPicture.astro';
import FadeUp from '@components/ui/FadeUp.astro';
import RevealHeader from '@components/sections/RevealHeader.astro';
import ContactFooterAlt from '@components/sections/ContactFooterAlt.astro';
import ServiceSliderAlt from '@components/sections/ServiceSliderAlt.astro';
import Button from '@components/ui/Button.astro';
import about from '@images/centreiam2.png';
import leaders from '@images/hands_tangible.jpg';
import mobcentre from '@images/AH1A3167.jpg';
import mob from '@images/hands.jpg';

import { pick, type I18nField } from '@lib/sanity/i18n';
import { getSiteSettings } from '@lib/sanity/queries';
import { formCopy } from '@lib/content/siteCopy';
import type { LocaleId } from '@lib/i18n/locales';

interface Props {
    data: Record<string, any> | null;
    locale: LocaleId;
}

const { data, locale } = Astro.props;
const t = (key: string) => pick(data?.[key] as I18nField, locale);

/**
 * The booking form's field labels are shared with the contact page and the
 * contact footer, so they come from Site Settings → Forms. Only the event
 * description label is particular to the Centre, and that one is authored on
 * this document.
 */
const settings = await getSiteSettings();
const f = formCopy(settings, locale);

const heroFonts = ['formula', 'formula', 'editorial', 'editorial'] as const;

// Shape classes are a design decision — map each slide to its visual style.
const shapeClasses = ['starburst', 'diamond', 'sparkle', 'circle', 'hexagon'] as const;

const slides = (data?.slides ?? []).map(
    (slide: { title: I18nField; description: I18nField }, i: number) => ({
        shapeClass: shapeClasses[i] ?? 'circle',
        // Every line break the editor typed — the heading is rendered with
        // `set:html`, so raw newlines would otherwise collapse away.
        shapeTitle: pick(slide.title, locale).replace(/\r?\n/g, '<br/>'),
        descriptions: [{ text: pick(slide.description, locale) }]
    })
);

/** The booking form's fields, in the order the frame lists them. */
const textFields = [
    { name: 'name', type: 'text', label: f.nameLabel },
    { name: 'email', type: 'email', label: f.emailLabel },
    { name: 'phone', type: 'tel', label: f.phoneLabel },
    { name: 'entreprise', type: 'text', label: f.companyLabel },
    { name: 'site', type: 'text', label: f.siteLabel }
] as const;

const labelClass =
    'block font-radio text-mob-section leading-[1.2] tracking-[0.02em] uppercase opacity-75 md:text-main-section';
const inputClass = 'w-full border-b border-b-perle text-main outline-0';
---

<BaseLayout title={t('metaTitle')} description={t('metaDescription')}>
    <div
        class="relative flex aspect-393/852 max-h-dvh w-full flex-col justify-end overflow-hidden bg-offwhite px-page md:aspect-1512/902 md:justify-center md:pb-0 md:[--page-gutter:var(--spacing-fluid-forty)]"
    >
        <div class="absolute inset-0 z-0">
            <SanityPicture
                image={data?.heroImage}
                fallback={leaders}
                {locale}
                alt="A clipboard and paper"
                layout="full-width"
                loading="eager"
                class="hidden h-full w-full object-cover md:flex"
            />
            <SanityPicture
                image={data?.heroImageMobile ?? data?.heroImage}
                fallback={mob}
                {locale}
                alt="A clipboard and paper"
                layout="full-width"
                loading="eager"
                class="flex h-full w-full object-cover md:hidden"
            />
        </div>

        <div class="w-full pb-mob-64 md:pb-0">
            <RevealHeader
                delay={0.25}
                textColor="#FFFFFF"
                lines={[t('heroLine1'), t('heroLine2'), t('heroLine3'), t('heroLine4')]
                    .filter((text): text is string => Boolean(text))
                    .map((text, i) => ({ text, font: heroFonts[i] }))}
            />
        </div>
    </div>

    <div
        class="flex flex-col bg-offwhite px-page pb-mob-64 md:grid md:h-fit md:w-full md:grid-cols-12 md:gap-gutter md:py-main-80"
    >
        {
            /* The frame opens this band with the section label, above the photo.
            Desktop keeps it at the top of the text column, which sits after the
            photo in the DOM — so the mobile copy is written separately and each
            shows at one size only. */
        }
        <div
            class="flex w-full flex-row items-center justify-center border-b border-b-perle pt-mob-64 pb-mob-16 font-radio text-mob-section tracking-[3%] uppercase md:hidden"
        >
            {t('aboutSectionLabel')}
        </div>

        <div
            class="w-full px-mob-inset-inner pt-mob-64 md:col-span-4 md:flex md:px-0 md:pt-0 md:pr-gutter"
        >
            <FadeUp>
                <SanityPicture
                    image={data?.aboutImage}
                    fallback={about}
                    {locale}
                    alt="Ron Cherilus"
                    class="aspect-267/343 w-full object-cover md:aspect-444/668"
                />
            </FadeUp>
        </div>

        <div
            class="flex h-full w-full flex-col items-center justify-start gap-mob-32 md:col-span-8 md:gap-main-80 md:border-b md:border-b-perle"
        >
            <div
                class="hidden w-full flex-row items-center justify-center border-b border-b-perle pb-main-12 font-radio text-main-section tracking-[3%] uppercase md:flex"
            >
                {t('aboutSectionLabel')}
            </div>
            <div
                class="flex flex-col items-center justify-center gap-mob-32 pt-mob-64 md:gap-main-40 md:px-main-60 md:pt-0"
            >
                <p
                    class="text-mob-body leading-[120%] font-light tracking-[0.02em] whitespace-pre-line md:text-main"
                >
                    {t('aboutBody')}
                </p>
                {
                    t('aboutBodyParagraph') && (
                        <p class="text-mob-caption leading-[120%] tracking-[0.03em] whitespace-pre-line md:text-main-body md:leading-[1.2]">
                            {t('aboutBodyParagraph')}
                        </p>
                    )
                }
            </div>
        </div>
    </div>

    <!-- ===================================================================
         The bronze band: the room itself, and the form to book it.
         =================================================================== -->
    <contact-form
        style="display: contents;"
        data-btn-submit={f.submitText}
        data-btn-success={f.successText}
    >
        <div class="flex flex-col gap-0 bg-bronze px-page pt-0 text-perle md:pt-main-80">
            <div
                class="grid h-fit grid-cols-12 gap-gutter border-b border-b-perle pb-mob-64 max-md:flex max-md:flex-col max-md:pb-0 md:border-none"
            >
                <div
                    class="col-span-6 flex h-full flex-col gap-main-80 border-b border-perle max-md:contents"
                >
                    <div
                        class="flex w-full flex-row items-center justify-center border-b border-b-perle font-radio text-mob-section tracking-[0.03em] uppercase max-md:order-1 max-md:pt-mob-64 max-md:pb-mob-16 md:pb-main-12 md:text-main-section"
                    >
                        {t('venueSectionLabel')}
                    </div>
                    <p
                        class="text-mob-body leading-[120%] font-light tracking-[0.02em] whitespace-pre-line max-md:order-3 max-md:pt-mob-64 md:px-main-60 md:text-main md:leading-[1.2]"
                    >
                        {t('venueBody')}
                    </p>
                </div>
                <div class="col-span-6 pl-gutter max-md:order-2 max-md:pt-mob-64 max-md:pl-0">
                    <SanityPicture
                        image={data?.venueImage}
                        fallback={mobcentre}
                        {locale}
                        alt="I AM Center"
                        class="aspect-square w-full object-cover"
                    />
                </div>
            </div>
            <div class="grid grid-cols-12 gap-gutter py-mob-64 md:py-main-160">
                <div class="col-span-12 md:col-span-8 md:col-start-3">
                    <div
                        class="text-mob-body leading-[120%] font-light tracking-[0.02em] md:text-main md:leading-[1.2]"
                    >
                        {t('bookingHeading')}
                    </div>

                    <form class="contact-form-inner flex flex-col gap-gutter pt-gutter">
                        <input type="hidden" name="access_key" value={f.accessKey} />

                        {
                            textFields.map((field) => (
                                <div class="flex flex-col gap-0">
                                    <label for={field.name} class={labelClass}>
                                        {field.label}
                                    </label>
                                    <input
                                        type={field.type}
                                        id={field.name}
                                        name={field.name}
                                        class={inputClass}
                                        required
                                    />
                                </div>
                            ))
                        }

                        <div class="flex flex-col gap-0">
                            <label for="message" class={labelClass}>
                                {t('bookingMessageLabel') || f.messageLabel}
                            </label>
                            <textarea
                                id="message"
                                name="message"
                                class={inputClass}
                                required
                                rows="5"></textarea>
                        </div>
                        <div class="flex flex-row justify-center pt-main-60">
                            <Button class="submit-btn" type="submit">{f.submitText}</Button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </contact-form>

    <ServiceSliderAlt {slides} lang={locale} />

    <ContactFooterAlt
        heading={t('contactFooterHeading')}
        paragraph={t('contactFooterParagraph')}
        mobBody={t('contactFooterMobBody')}
        lang={locale}
    />
</BaseLayout>

<script>
    import '@scripts/contactForm';
</script>
