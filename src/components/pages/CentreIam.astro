---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import FadeUp from '@components/ui/FadeUp.astro';
import RevealHeader from '@components/sections/RevealHeader.astro';
import ContactFooterAlt from '@components/sections/ContactFooterAlt.astro';
import ServiceSliderAlt from '@components/sections/ServiceSliderAlt.astro';
import Button from '@components/ui/Button.astro';
import about from '@images/centreiam2.png';
import leaders from '@images/hands_tangible.jpg';
import mobcentre from '@images/AH1A3167.jpg';
import mob from '@images/hands.jpg';

import { pick, type I18nField } from '@lib/sanity/i18n';
import type { LocaleId } from '@lib/i18n/locales';

interface Props {
    data: Record<string, any> | null;
    locale: LocaleId;
}

const { data, locale } = Astro.props;
const t = (key: string) => pick(data?.[key] as I18nField, locale);

const heroFonts = ['formula', 'formula', 'editorial', 'editorial'] as const;

// Shape classes are a design decision — map each slide to its visual style.
const shapeClasses = ['starburst', 'diamond', 'sparkle', 'circle', 'hexagon'] as const;

const slides = (data?.slides ?? []).map(
    (slide: { title: I18nField; description: I18nField }, i: number) => ({
        shapeClass: shapeClasses[i] ?? 'circle',
        // Every line break the editor typed — the heading is rendered with
        // `set:html`, so raw newlines would otherwise collapse away.
        shapeTitle: pick(slide.title, locale).replace(/\r?\n/g, '<br/>'),
        descriptions: [{ text: pick(slide.description, locale) }]
    })
);
---

<BaseLayout title="I AM Center">
    <div
        class="relative flex w-full aspect-393/852 max-h-dvh flex-col justify-end overflow-hidden bg-offwhite px-page md:[--page-gutter:var(--spacing-fluid-forty)] md:aspect-1512/902 md:justify-center md:pb-0"
    >

        <div class="absolute inset-0 z-0">
            <Picture
                alt="A clipboard and paper"
                src={leaders}
                layout="full-width"
                class="hidden h-full w-full object-cover md:flex"
            />
            <Picture
                alt="A clipboard and paper"
                src={mob}
                layout="full-width"
                class="flex h-full w-full object-cover md:hidden"
            />
        </div>

        <div class="w-full pb-mob-64 md:pb-0">
            <RevealHeader
                delay={0.25}
                textColor="#FFFFFF"
                lines={[t('heroLine1'), t('heroLine2'), t('heroLine3'), t('heroLine4')]
                    .filter((text): text is string => Boolean(text))
                    .map((text, i) => ({ text, font: heroFonts[i] }))}
            />
        </div>

    </div>

    <div
        class="flex flex-col bg-offwhite px-page pb-mob-64 md:grid md:h-fit md:w-full md:grid-cols-12 md:gap-gutter md:py-main-80"
    >

        {/* The frame opens this band with the section label, above the photo.
            Desktop keeps it at the top of the text column, which sits after the
            photo in the DOM — so the mobile copy is written separately and each
            shows at one size only. */}
        <div
            class="flex w-full flex-row items-center justify-center border-b border-b-perle pt-mob-64 pb-mob-16 font-radio text-mob-section tracking-[3%] uppercase md:hidden"
        >
            {t('aboutSectionLabel')}
        </div>

        <div class="w-full px-mob-inset-inner pt-mob-64 md:col-span-4 md:flex md:px-0 md:pt-0 md:pr-gutter">
            <FadeUp>
                <Picture
                    src={about}
                    alt="Ron Cherilus"
                    class="aspect-267/343 w-full object-cover md:aspect-444/668"
                />
            </FadeUp>
        </div>

        <div
            class="flex h-full w-full flex-col items-center justify-start gap-mob-32 md:col-span-8 md:gap-main-80 md:border-b md:border-b-perle"
        >
            <div
                class="font-radio hidden w-full flex-row items-center justify-center border-b border-b-perle pb-main-12 text-main-section tracking-[3%] uppercase md:flex"
            >
                {t('aboutSectionLabel')}
            </div>
            <div class="flex flex-col justify-center items-center gap-mob-32 pt-mob-64 md:gap-main-40 md:px-main-60 md:pt-0">
                <p
                    class="text-mob-body leading-[120%] font-light tracking-[0.02em] whitespace-pre-line md:text-main"
                >
                    {t('aboutBody')}
                </p>
                {
                    t('aboutBodyParagraph') && (
                        <p class="text-mob-caption leading-[120%] tracking-[0.03em] whitespace-pre-line md:text-main-body md:leading-[1.2]">
                            {t('aboutBodyParagraph')}
                        </p>
                    )
                }
            </div>
        </div>

    </div>

    <div class="flex flex-col gap-0 bg-bronze text-perle px-page pt-0 md:pt-main-80">
        <div class="grid grid-cols-12 gap-gutter h-fit max-md:flex max-md:flex-col">
            <div class="col-span-6 flex flex-col gap-main-80 h-full border-b border-perle max-md:contents">
                <div
                    class="font-radio w-full flex flex-row items-center justify-center border-b border-b-perle text-mob-section tracking-[0.03em] uppercase max-md:order-1 max-md:pt-mob-64 max-md:pb-mob-16 md:pb-main-12 md:text-main-section"
                >
                    {t('aboutSectionLabel')}
                </div>
                <p class="text-mob-body font-light tracking-[0.02em] leading-[120%] max-md:order-3 max-md:pt-mob-64 md:text-main md:leading-[1.2] md:px-main-60">
                    Offrez à vos événements un espace qui inspire autant les idées que les connexions humaines. Situé au cœur du centre-ville, le Centre I AM accueille vos rencontres corporatives, ateliers et expériences collaboratives dans une atmosphère chaleureuse, lumineuse et propice aux échanges porteurs de sens.
                </p>
            </div>
            <div class="col-span-6 pl-gutter max-md:order-2 max-md:pt-mob-64 max-md:pl-0">
                <Picture src={mobcentre} alt="I AM Center" class="aspect-square w-full object-cover" />
            </div>
        </div>
        <div
            class="grid grid-cols-12 gap-gutter py-mob-64 md:py-main-160"
        >

            <div class="col-span-12 md:col-span-8 md:col-start-3">
                <div class="font-light text-mob-body tracking-[0.02em] leading-[120%] md:text-main md:leading-[1.2]">
                    Réservez le Centre I AM
                </div>

                <form id="contact-form" class="flex flex-col gap-gutter pt-gutter">

                    <input type="hidden" name="access_key" value="3cb859b7-eb03-4988-a1d8-38cf672ee0c8" />

                    <div class="flex flex-col gap-0">
                        <label
                            for="name"
                            class="font-radio block text-mob-section tracking-[0.02em] leading-[1.2] uppercase opacity-75 md:text-main-section"
                        >
                            Nom
                        </label>
                        <input
                            type="text"
                            class="w-full border-b border-b-perle text-main outline-0"
                            name="name"
                            required
                        />
                    </div>

                    <div class="flex flex-col gap-0">
                        <label
                            for="email"
                            class="font-radio block text-mob-section tracking-[0.02em] leading-[1.2] uppercase opacity-75 md:text-main-section"
                        >
                            Courriel
                        </label>
                        <input
                            type="email"
                            class="w-full border-b border-b-perle text-main outline-0"
                            name="email"
                            required
                        />
                    </div>

                    <div class="flex flex-col gap-0">
                        <label
                            for="phone"
                            class="font-radio block text-mob-section tracking-[0.02em] leading-[1.2] uppercase opacity-75 md:text-main-section"
                        >
                            Téléphone
                        </label>
                        <input
                            type="tel"
                            class="w-full border-b border-b-perle text-main outline-0"
                            name="phone"
                            required
                        />
                    </div>

                    <div class="flex flex-col gap-0">
                        <label
                            for="entreprise"
                            class="font-radio block text-mob-section tracking-[0.02em] leading-[1.2] uppercase opacity-75 md:text-main-section"
                        >
                            Entreprise
                        </label>
                        <input
                            type="text"
                            class="w-full border-b border-b-perle text-main outline-0"
                            name="entreprise"
                            required
                        />
                    </div>

                    <div class="flex flex-col gap-0">
                        <label
                            for="site"
                            class="font-radio block text-mob-section tracking-[0.02em] leading-[1.2] uppercase opacity-75 md:text-main-section"
                        >
                            Site de l'entreprise
                        </label>
                        <input
                            type="text"
                            class="w-full border-b border-b-perle text-main outline-0"
                            name="site"
                            required
                        />
                    </div>

                    <div class="flex flex-col gap-0">
                        <label
                            for="message"
                            class="font-radio block text-mob-section tracking-[0.02em] leading-[1.2] uppercase opacity-75 md:text-main-section"
                        >
                            Info supplémentaires/Description de l'événement*
                        </label>
                        <textarea
                            name="message"
                            class="w-full border-b border-b-perle text-main outline-0"
                        required
                        rows="5">

                        </textarea>
                    </div>
                    <div class="flex flex-row justify-center pt-main-60">
                        <Button id="submit-btn" type="submit">Soumettre</Button>
                    </div>
                </form>
            </div>
        </div>
    </div>


         <ServiceSliderAlt {slides} />



    <ContactFooterAlt heading={t('contactFooterHeading')} lang={locale} />
</BaseLayout>
