---
import BaseLayout from '@layouts/BaseLayout.astro';
import SanityPicture from '@components/ui/SanityPicture.astro';
import RevealHeader from '@components/sections/RevealHeader.astro';
import SplitReveal from '@components/sections/SplitReveal.astro';
import Button from '@components/ui/Button.astro';

import building from '@images/AH1A3167.jpg';
import mob from '@images/building-mob.jpg';

import { pick, type I18nField } from '@lib/sanity/i18n';
import { getSiteSettings } from '@lib/sanity/queries';
import { formCopy } from '@lib/content/siteCopy';
import type { LocaleId } from '@lib/i18n/locales';

interface Props {
    data: Record<string, any> | null;
    locale: LocaleId;
}

const { data, locale } = Astro.props;
const t = (key: string) => pick(data?.[key] as I18nField, locale);

/**
 * The field labels are not this page's content — the same form is drawn in the
 * contact footer of every other page and on the Centre I AM page — so they are
 * authored once under Site Settings → Forms and read from there.
 */
const settings = await getSiteSettings();
const f = formCopy(settings, locale);

const heroFonts = ['formula', 'formula', 'editorial', 'editorial'] as const;

/** The five identity fields, in the order the frame lists them. */
const textFields = [
    { name: 'name', type: 'text', label: f.nameLabel },
    { name: 'email', type: 'email', label: f.emailLabel },
    { name: 'phone', type: 'tel', label: f.phoneLabel },
    { name: 'entreprise', type: 'text', label: f.companyLabel },
    { name: 'site', type: 'text', label: f.siteLabel }
] as const;

/** The three qualification groups, each a set of radio options. */
const radioGroups = [
    { name: 'employes', label: f.employeesLabel, options: f.employeesOptions },
    { name: 'budget', label: f.budgetLabel, options: f.budgetOptions },
    { name: 'accompagnement', label: f.supportLabel, options: f.supportOptions }
];

const labelClass =
    'block font-radio text-mob-section leading-[1.2] tracking-[0.02em] uppercase opacity-75 md:text-main-section';
const inputClass = 'w-full border-b border-b-black text-main outline-0';
const optionClass =
    'flex cursor-pointer items-center gap-main-12 font-radio text-mob-section leading-[1.2] tracking-[0.02em] uppercase opacity-75 md:text-main-section';
const radioClass =
    'h-[calc(1.2em-4px)] w-[calc(1.2em-4px)] shrink-0 appearance-none rounded-full border border-black bg-transparent outline-0 checked:bg-black';
---

<BaseLayout title={t('metaTitle')} description={t('metaDescription')}>
    <div
        class="relative flex aspect-393/852 max-h-svh w-full flex-col justify-end overflow-hidden bg-offwhite px-page md:aspect-1512/902 md:justify-center md:pb-0 md:[--page-gutter:var(--spacing-fluid-forty)]"
    >
        <div class="absolute inset-0 z-0">
            <SanityPicture
                image={data?.heroImage}
                fallback={building}
                {locale}
                alt="A clipboard and paper"
                layout="full-width"
                loading="eager"
                class="hidden h-full w-full object-cover brightness-75 md:flex"
            />
            <SanityPicture
                image={data?.heroImageMobile ?? data?.heroImage}
                fallback={mob}
                {locale}
                alt="A clipboard and paper"
                layout="full-width"
                loading="eager"
                class="flex h-full w-full object-cover brightness-75 md:hidden"
            />
        </div>
        <div class="pb-mob-64 md:pb-0">
            <RevealHeader
                delay={0.25}
                textColor="#FFFFFF"
                lines={[t('heroLine1'), t('heroLine2'), t('heroLine3'), t('heroLine4')]
                    .filter((text): text is string => Boolean(text))
                    .map((text, i) => ({ text, font: heroFonts[i] }))}
            />
        </div>
    </div>

    <div
        class="grid h-fit grid-cols-12 gap-main-12 bg-perle px-page py-mob-128 md:pt-fluid-160 md:pb-fluid-160 md:[--page-gutter:var(--spacing-fluid-forty)]"
    >
        <div
            class="col-span-12 flex h-full flex-col justify-start gap-fluid-eighty md:col-span-8 md:col-start-3"
        >
            <div class="flex flex-col gap-mob-32 md:gap-fluid-forty">
                <SplitReveal
                    class="w-full text-mob-body leading-[120%] font-bold tracking-[2%] text-bronze md:text-body-md"
                >
                    {t('introBold')}
                </SplitReveal>
                <div
                    class="flex flex-col gap-0 text-mob-body leading-[120%] font-light tracking-[2%] md:gap-fluid-forty md:text-body-md"
                >
                    <p class="pb-fluid-forty whitespace-pre-line md:pb-0">
                        {t('introBody')}
                    </p>
                </div>
            </div>
        </div>
    </div>

    {
        /* The whole form, in one step — the two-step paging belongs to the
           contact footer, where the band has no room to show all of it at once.
           `<contact-form>` is what binds the submit handler; without it the form
           would post nowhere. */
    }
    <contact-form
        style="display: contents;"
        data-btn-submit={f.submitText}
        data-btn-success={f.successText}
    >
        <div
            class="mx-auto grid w-full max-w-page grid-cols-12 gap-gutter px-frame py-mob-64 md:px-0 md:py-main-160"
        >
            <div class="col-span-12 md:col-span-8 md:col-start-3">
                <div
                    class="pb-3 text-mob-body leading-[1.2] font-light tracking-[0.02em] md:pb-1 md:text-main"
                >
                    {t('formHeading')}
                </div>

                <form class="contact-form-inner flex flex-col gap-gutter pt-gutter">
                    <input type="hidden" name="access_key" value={f.accessKey} />

                    {
                        textFields.map((field) => (
                            <div class="flex flex-col gap-0">
                                <label for={field.name} class={labelClass}>
                                    {field.label}
                                </label>
                                <input
                                    type={field.type}
                                    id={field.name}
                                    name={field.name}
                                    class={inputClass}
                                    required
                                />
                            </div>
                        ))
                    }

                    {
                        radioGroups.map((group) => (
                            <div class="flex flex-col gap-0 border-b border-b-black pb-gutter">
                                <span class={labelClass}>{group.label}</span>
                                <div class="flex flex-col gap-main-12 pt-main-12">
                                    {group.options.map((option, i) => (
                                        <label for={`${group.name}-${i}`} class={optionClass}>
                                            <input
                                                type="radio"
                                                id={`${group.name}-${i}`}
                                                name={group.name}
                                                value={option}
                                                required
                                                class={radioClass}
                                            />
                                            {option}
                                        </label>
                                    ))}
                                </div>
                            </div>
                        ))
                    }

                    <label
                        for="consultation"
                        class="text-[clamp(0.75rem, 0.2788rem + 1.9185vw, 1.25rem)] w-full cursor-pointer leading-[1.2] font-light tracking-[0.02em] md:text-main-body"
                    >
                        <div class="flex h-full w-full items-start gap-gutter">
                            <input
                                type="checkbox"
                                id="consultation"
                                name="consultation"
                                value="Oui"
                                required
                                class="mt-1 h-[calc(1.2em-8px)] w-[calc(1.2em-8px)] shrink-0 appearance-none border border-black bg-transparent outline-0 checked:bg-black"
                            />
                            {f.consultationLabel}
                        </div>
                    </label>

                    <div class="flex flex-row justify-center pt-main-60">
                        <Button class="submit-btn" type="submit">{f.submitText}</Button>
                    </div>
                </form>
            </div>
        </div>
    </contact-form>
</BaseLayout>

<script>
    import '@scripts/contactForm';
</script>
