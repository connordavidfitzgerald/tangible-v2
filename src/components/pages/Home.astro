---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import SanityPicture from '@components/ui/SanityPicture.astro';
import DashList from '@components/ui/DashList.astro';
import RevealHeader from '@components/sections/RevealHeader.astro';
import ContactFooter from '@components/sections/ContactFooter.astro';
import SplitReveal from '@components/sections/SplitReveal.astro';
import MuxVideo from '@components/ui/MuxVideo.astro';
import LottieAnimation from 'astro-integration-lottie/Lottie.astro';
import plantAnimationUrl from '@images/plant.json?url';

import chalkboard from '@images/Home_about.jpg';
import img1 from '@images/tangible1.jpg';
import img2 from '@images/tangible2.jpg';
import img3 from '@images/tangible3.jpg';
import img4 from '@images/tangible4.jpg';
import img5 from '@images/tangible5.jpg';
import img6 from '@images/Tangible0797.jpg';
import img7 from '@images/LEADER.jpg';
import mob1 from '@images/mob_tang1.jpg';
import mob2 from '@images/mob_tang2.jpg';
import mob3 from '@images/mob_tang3.jpg';
import mob4 from '@images/mob_tang4.jpg';
import mob5 from '@images/mob_tang5.jpg';

import { localizedPath } from '@lib/i18n/utils';
import { pick, type I18nField } from '@lib/sanity/i18n';
import { getSiteSettings } from '@lib/sanity/queries';
import { muxPlaybackId } from '@lib/sanity/video';
import { HERO_TITLES, INTRO_BOLD, INTRO_BODY } from '@lib/content/homeFallbacks';
import type { LocaleId } from '@lib/i18n/locales';

interface Props {
    data: Record<string, any> | null;
    locale: LocaleId;
}

const { data, locale } = Astro.props;
const t = (key: string) => pick(data?.[key] as I18nField, locale);

/** The film is global (Site Settings), not home-page content. */
const settings = await getSiteSettings();
const videoPlaybackId = muxPlaybackId(settings);
const videoTitle = pick(settings?.videoTitle, locale);

const heroFonts = ['formula', 'editorial', 'editorial'] as const;
const entreprisesTitleFonts = ['formula', 'editorial'] as const;
const leadersTitleFonts = ['formula', 'editorial'] as const;

/**
 * Every section below is a single markup tree that re-lays out at `md` (810px):
 * mobile-first classes describe the stacked layout, `md:` classes describe the
 * wide one. The hero is the one exception — its mobile crops are separate image
 * assets, so both sets stay in the DOM and swap at `sm` (700px).
 */
const heroPhotos = [
    { desktop: img1, mobile: mob1 },
    { desktop: img2, mobile: mob2 },
    { desktop: img3, mobile: mob3 },
    { desktop: img4, mobile: mob4 },
    { desktop: img5, mobile: mob5 }
];

/**
 * Each photo carries its own title, and the two run off the same CSS clock (see
 * the style block) so a title is only ever on screen over its own photo. They
 * are authored together in Sanity (`heroSlides`) for exactly that reason.
 *
 * With the array empty the hero runs the five drawn photos above with the copy
 * in `homeFallbacks`; the first slide falls back to `heroLine1-3`, which is the
 * page's `h1` and already authored. Fill the array in and it takes over — the
 * photos with it, since the count then comes from Sanity rather than from here.
 */
const authoredSlides: any[] = Array.isArray(data?.heroSlides) ? data.heroSlides : [];
const baseHeroLines = [t('heroLine1'), t('heroLine2'), t('heroLine3')].filter(Boolean);

const heroTitleLines = (entry: any, index: number) => {
    const authored = entry
        ? [pick(entry.line1, locale), pick(entry.line2, locale), pick(entry.line3, locale)].filter(
              Boolean
          )
        : [];
    if (authored.length) return authored;

    const fallback = HERO_TITLES[locale]?.[index] ?? [];
    return fallback.length ? fallback : baseHeroLines;
};

const heroSource = authoredSlides.length ? authoredSlides : heroPhotos;

const heroSlides = heroSource.map((entry: any, i: number) => ({
    // The drawn photos are `ImageMetadata`; the authored ones are Sanity image
    // fields. `SanityPicture` takes one of each and prefers the upload, so the
    // two shapes are handed over together and it settles which one draws.
    image: authoredSlides.length ? entry.desktop : null,
    imageMobile: authoredSlides.length ? (entry.mobile ?? entry.desktop) : null,
    fallback: authoredSlides.length ? (heroPhotos[i]?.desktop ?? null) : entry.desktop,
    fallbackMobile: authoredSlides.length ? (heroPhotos[i]?.mobile ?? null) : entry.mobile,
    lines: heroTitleLines(authoredSlides.length ? entry : null, i).map((text, line) => ({
        text,
        font: heroFonts[line] ?? 'editorial'
    }))
}));

/**
 * The intro band is drawn on both frames, but its two fields are empty in the
 * dataset, and an empty lead sentence takes the whole band off the page. So it
 * falls back to the drawn copy, which any Studio edit then replaces.
 */
const introBold = t('introBold') || INTRO_BOLD[locale];
const introBody = t('introBody') || INTRO_BODY[locale];

const programs = [
    {
        image: data?.entreprisesImage,
        fallback: img6,
        alt: 'Corporate Coaching',
        titleLines: [t('entreprisesTitle1'), t('entreprisesTitle2')],
        titleFonts: entreprisesTitleFonts,
        body: t('entreprisesBody'),
        buttonLabel: t('entreprisesButton'),
        href: localizedPath('/services/entreprises', locale),
        side: 'left' as const
    },
    {
        image: data?.leadersImage,
        fallback: img7,
        alt: 'Leadership Coaching',
        titleLines: [t('leadersTitle1'), t('leadersTitle2')],
        titleFonts: leadersTitleFonts,
        body: t('leadersBody'),
        buttonLabel: t('leadersButton'),
        href: localizedPath('/services/leaders', locale),
        side: 'right' as const
    }
];

/**
 * Program blocks alternate which side the image sits on at `md`. Mobile always
 * stacks header → image → text, so only the wide layout needs placement.
 * Class strings are spelled out in full so Tailwind's scanner can find them.
 */
const programSide = {
    left: {
        image: 'md:col-start-1 md:pr-fluid-twenty',
        column: 'md:col-start-5 md:pr-fluid-sixty md:pl-fluid-sixty'
    },
    right: {
        image: 'md:col-start-9 md:pl-fluid-twenty',
        column: 'md:col-start-1 md:pr-fluid-sixty md:pl-fluid-sixty'
    }
};

/**
 * The hero's two keyframe sets, written out for the number of slides there
 * actually are.
 *
 * They cannot live in the stylesheet with the rest: a keyframe *stop* is a
 * percentage of the cycle, and the cycle is now however many photos have been
 * authored. At five slides these compute to exactly the 15/20/95 the block used
 * to hardcode, so a five-photo hero is unchanged.
 *
 * `is:inline` keeps Astro's hand off it — the names have to survive verbatim
 * for the scoped `animation` declarations below to reach them, and scoping
 * would rewrite one side of that pair and not the other.
 */
const SLIDE_SECONDS = 4;
const FADE_SECONDS = 1;
const cycle = heroSlides.length * SLIDE_SECONDS;
const pct = (seconds: number) => +((seconds / cycle) * 100).toFixed(4);
const hold = pct(SLIDE_SECONDS);
const fade = pct(FADE_SECONDS);

const heroKeyframes = `
@keyframes hero-fade {
    0% { opacity: 1 }
    ${hold - fade}% { opacity: 1 }
    ${hold}% { opacity: 0 }
    ${100 - fade}% { opacity: 0 }
    100% { opacity: 1 }
}
@keyframes hero-title-fade {
    0% { opacity: 0 }
    ${fade}% { opacity: 1 }
    ${hold}% { opacity: 1 }
    ${hold + fade}% { opacity: 0 }
    100% { opacity: 0 }
}`;
---

<style is:inline set:html={heroKeyframes}></style>

<BaseLayout title={t('metaTitle')} description={t('metaDescription')} themeColor="#000000">
    <!-- ===================================================================
         Hero
         =================================================================== -->
    {
        /* Four seconds a slide. The cycle used to be a flat 20s because there
           were always five of them; the count now comes from Sanity, so it is
           published as a variable and the keyframes below read it — otherwise
           adding a sixth photo would leave the whole rotation off its clock. */
    }
    {
        /* The hero is a photograph, so there is no background colour to sample —
           `data-theme-color` states the one Safari should paint the notch with.
           Black, because the slides run under `brightness-80` behind white type. */
    }
    <div
        data-theme-color="#000000"
        class="hero-section relative flex aspect-393/852 w-full flex-col justify-end overflow-hidden px-page pb-mob-64 max-md:h-lvh md:aspect-auto md:min-h-200 md:pb-fluid-270 lg:aspect-1512/913 lg:min-h-0 lg:justify-center lg:pb-0"
        style={`--hero-cycle: ${heroSlides.length * 4}s`}
    >
        <div class="hero-slideshow hidden brightness-80 md:flex">
            {
                heroSlides.map(({ image, fallback }, i) => (
                    <div
                        class="hero-slide"
                        style={`z-index: ${heroSlides.length - i}; animation-delay: ${i * 4}s`}
                        aria-hidden="true"
                    >
                        <SanityPicture
                            {image}
                            {fallback}
                            {locale}
                            alt=""
                            layout="full-width"
                            loading={i === 0 ? 'eager' : 'lazy'}
                        />
                    </div>
                ))
            }
        </div>
        <div class="hero-slideshow flex brightness-80 md:hidden">
            {
                heroSlides.map(({ imageMobile, fallbackMobile }, i) => (
                    <div
                        class="hero-slide"
                        style={`z-index: ${heroSlides.length - i}; animation-delay: ${i * 4}s`}
                        aria-hidden="true"
                    >
                        <SanityPicture
                            image={imageMobile}
                            fallback={fallbackMobile}
                            {locale}
                            alt=""
                            layout="full-width"
                            loading={i === 0 ? 'eager' : 'lazy'}
                        />
                    </div>
                ))
            }
        </div>

        {
            /* The titles stack in one grid cell so the block keeps the height of
               the tallest — a shorter title in the rotation must not move the
               ones around it — and sit on their shared bottom edge, which is the
               edge the frame positions against. Only the first is the page's
               heading; the rest are its decorative variants, so they render as
               `p` and stay out of the accessibility tree, like the photos.

               `min-w-0` on each because that shared cell is an `auto` track, and
               an `auto` track refuses to go below its content's min-content — a
               single long word at display size on a phone, which held the cell
               open at 507px inside a 361px column and took the document's scroll
               width with it. The automatic minimum is the only thing propping it
               open; without it the cell is the column's width and
               `RevealHeader`'s own mask trims the line. */
        }
        <div class="relative z-10 grid items-end">
            {
                heroSlides.map(({ lines }, i) => (
                    <div
                        class="hero-title col-start-1 row-start-1 min-w-0"
                        style={`animation-delay: ${i * 4 - 1}s`}
                        aria-hidden={i > 0 ? 'true' : undefined}
                    >
                        <RevealHeader
                            delay={0.25}
                            textColor={'#FFFFFF'}
                            as={i === 0 ? 'h1' : 'p'}
                            lines={lines}
                        />
                    </div>
                ))
            }
        </div>
    </div>

    <!-- ===================================================================
         About
         =================================================================== -->
    <div
        class="flex flex-col bg-offwhite px-page pb-mob-64 md:grid md:grid-cols-12 md:gap-gutter md:pt-main-80 md:pb-main-80"
    >
        {
            /* The frame runs label → image → copy → button, but the desktop grid
            keeps the label at the top of the text column. Rather than reorder a
            working layout, the label is written twice and each copy shows at one
            size only — it is a single line, and the alternative is moving a
            desktop element for a mobile reason. */
        }
        <div
            class="flex w-full flex-row items-center justify-center border-b border-b-perle pt-mob-64 pb-mob-16 font-radio text-mob-section leading-[1.2] tracking-[0.02em] uppercase md:hidden"
        >
            {t('aboutSectionLabel')}
        </div>

        <div
            class="about-media px-mob-inset-inner pt-mob-64 md:col-span-4 md:h-full md:px-0 md:pt-0 md:pr-gutter"
        >
            <div class="md:h-full">
                <SanityPicture
                    image={data?.aboutImage}
                    fallback={chalkboard}
                    {locale}
                    alt="chalkboard"
                    class="aspect-267/343 object-cover md:aspect-auto"
                    layout="full-width"
                    loading="lazy"
                    data-reveal
                />
            </div>
        </div>

        <div class="flex h-full flex-col md:col-span-8">
            <div
                class="hidden w-full flex-row items-center justify-center border-b border-b-perle pb-main-12 font-radio text-main-section leading-[1.2] tracking-[0.02em] uppercase md:flex"
            >
                {t('aboutSectionLabel')}
            </div>

            <div
                class="flex grow flex-col justify-center gap-mob-32 pt-mob-64 md:gap-main-40 md:px-main-40 md:pt-main-80"
            >
                <p class="text-mob-body leading-[1.2] font-light tracking-[0.03em] md:text-main">
                    <span class="font-bold text-bronze">Tangible</span>
                    {' '}{t('aboutBody')}
                </p>
                <p
                    class="text-mob-section leading-[1.2] tracking-[0.03em] whitespace-pre-line md:text-main-body md:leading-[1.2]"
                >
                    {t('aboutBody2')}
                </p>
            </div>
            <div
                class="flex w-full flex-row items-center justify-center pt-mob-32 md:border-b md:border-b-perle md:pt-main-80 md:pb-main-40"
            >
                <Button
                    class="text-mob-section tracking-[3%] uppercase md:text-main-section"
                    href={localizedPath('/about', locale)}
                >
                    {t('aboutButton')}
                </Button>
            </div>
        </div>
    </div>

    <!-- ===================================================================
         Mission
         =================================================================== -->
    {
        /* Mobile stacks the plant over the quote and lets the band find its own
        height; the drawn 1512/902 ratio only holds once the two sit side by
        side, so it starts at md. */
    }
    <div
        class="flex w-full flex-col gap-mob-64 bg-yellow px-page py-mob-64 md:grid md:aspect-[1512/902] md:h-auto md:max-h-frame-902 md:grid-cols-12 md:gap-gutter md:py-0"
    >
        <div
            class="order-2 flex flex-col items-center justify-center px-mob-inset-inner md:order-none md:col-span-5 md:col-start-2 md:px-0"
        >
            <SplitReveal
                class="font-radio text-mob-md leading-[1.15] font-normal md:text-quote md:leading-[1.1]"
            >
                {t('missionQuote')}
            </SplitReveal>
        </div>
        <div
            class="order-1 flex w-full flex-col justify-center mix-blend-multiply md:order-none md:col-span-5 md:col-start-8 md:h-full md:px-0"
        >
            <LottieAnimation src={plantAnimationUrl} autoplay={true} loop={true} />
        </div>
    </div>

    <!-- ===================================================================
         Programs — one block per program, image side alternates at md.
         =================================================================== -->
    <div class="flex h-fit flex-col bg-offwhite px-page pb-mob-64 md:py-main-40">
        <div
            class="flex w-full flex-row items-center justify-center border-b border-b-perle pt-mob-64 pb-mob-16 font-radio text-mob-section leading-[1.2] tracking-[0.03em] uppercase md:pt-0 md:pb-main-12 md:text-main-section"
        >
            {t('programsSectionLabel')}
        </div>

        {
            /* The frame runs title → image → list → button, while the wide
               layout nests all three text parts in one column beside the image.
               Rather than move that column, its wrappers go `display: contents`
               below md so every leaf becomes a direct flex child and `order`
               can rearrange them. All of it is `max-md:`, so the grid above 810
               never sees any of it. */
            programs.map((program, index) => (
                <div class="relative grid h-fit grid-cols-8 bg-offwhite pt-mob-64 max-md:flex max-md:flex-col md:grid-cols-12 md:gap-gutter md:pt-main-213">
                    <div
                        class:list={[
                            'col-span-8 h-full w-full border-b border-perle max-md:contents md:row-start-1 md:overflow-hidden',
                            programSide[program.side].column
                        ]}
                    >
                        <div class="flex flex-col justify-start gap-main-40 max-md:contents">
                            <div class="max-md:order-1">
                                <RevealHeader
                                    lines={program.titleLines.map((text, i) => ({
                                        text,
                                        font: program.titleFonts[i]
                                    }))}
                                />
                            </div>
                            <DashList
                                text={program.body}
                                class="text-mob-body leading-[120%] font-light tracking-[3%] max-md:order-3 max-md:px-mob-inset-inner max-md:pt-mob-32 md:text-main"
                            />
                        </div>

                        <div
                            class:list={[
                                'flex w-full flex-row items-center justify-center py-mob-64 max-md:order-4 md:border-none md:pt-main-59',
                                /* The rule divides one program block from the
                                   next, so it belongs under the first only —
                                   under the second there is nothing left to
                                   divide and it just fences off the film. */
                                index === 0 && 'border-b border-b-perle'
                            ]}
                        >
                            <Button
                                class="text-mob-section tracking-[0.03em] uppercase md:text-body-sm"
                                href={program.href}
                            >
                                {program.buttonLabel}
                            </Button>
                        </div>
                    </div>

                    {/* The inset and the grid placement live on this wrapper,
                           and never on the picture itself — the same split the
                           programs cards on `/services` use.

                           They were on the picture, with `box-content` to keep the
                           94px of inset out of the ratio's way, and that is a
                           construction the engines do not agree on. `SanityPicture`
                           renders `display: contents`, so the `img` was itself the
                           grid item; sizing it there put an explicit width, a
                           padding, a height and an `aspect-ratio` on one replaced
                           element at once. From that identical CSS, Blink laid out
                           the 267×367 asked for and WebKit produced 267×238 — the
                           height collapsing to less than the width, so the picture
                           came out wider than it was tall. Reproduced on an iPhone
                           14 Pro in both; the ratio is not the part they disagree
                           about, the height is.

                           A wrapper takes the question away: the div is a plain
                           border-box that absorbs the inset, and the picture is
                           left as a ratio and a width, which every engine computes
                           the same way.

                           On the picture itself, then:

                           267×367.43 is the mobile frame's own pair, and the one
                           the `/services` cards are cut to. It is literal rather
                           than proportional — the frame is 393 wide, and 393 less
                           the 16px page margin and the 47px inset on each side is
                           exactly the 267 column every image on a phone sits in —
                           so `w-full` is all it takes to hit it, and the ratio
                           takes the height from there.

                           No ratio at md, deliberately. `h-full` gives it a
                           definite height, the row's, which the text column sets;
                           and a box with a definite height and `width: auto` takes
                           its *width* from the ratio rather than from its grid
                           track, so as the viewport narrowed and the copy wrapped
                           taller the image grew wider with it and overflowed the
                           page: +102px at 810, tapering to 0 around 1280.
                           `min-width: 0` does not help, because the width is
                           computed rather than merely floored. Dropping the ratio
                           lets the track set the width and `h-full` set the height.

                           `object-cover` because both of those boxes are a shape
                           this layout decides, and neither has any reason to match
                           the photograph that lands in it. Without a fit the
                           default `fill` stretches one to the other: the
                           entreprises image is a 0.667 source, so it rendered 9%
                           wide on a phone, and at md the distortion moved with the
                           wrap of the copy beside it. */}
                    <div
                        class:list={[
                            'max-md:order-2 max-md:mt-mob-32 max-md:px-mob-inset-inner md:col-span-4 md:row-start-1 md:h-full md:overflow-clip',
                            programSide[program.side].image
                        ]}
                    >
                        <SanityPicture
                            image={program.image}
                            fallback={program.fallback}
                            {locale}
                            alt=""
                            class="aspect-[267/367.43] w-full object-cover md:aspect-auto md:h-full"
                            data-reveal
                        />
                    </div>
                </div>
            ))
        }
    </div>

    <!-- ===================================================================
         Video — full-bleed, sits between the programs and the contact footer.
         =================================================================== -->
    <MuxVideo
        playbackId={videoPlaybackId}
        title={videoTitle}
        autoplayInView
        class="aspect-1512/902 w-full"
    />

    <!-- ===================================================================
         Intro band — perle, between the film and the contact form. Its 948px
         column is `col-start-3 col-span-8` of the page grid, which lands its
         left edge on 282px at 1512, exactly as drawn.
         =================================================================== -->
    {
        introBold && (
            <div class="grid grid-cols-8 gap-mob-16 bg-perle px-page py-mob-128 md:grid-cols-12 md:gap-gutter md:py-fluid-160">
                <div class="col-span-8 flex flex-col gap-mob-32 md:col-span-8 md:col-start-3 md:gap-main-40">
                    <SplitReveal class="font-radio text-mob-body leading-[120%] font-light tracking-[0.03em] text-bronze md:text-main-lead md:leading-[120%] md:font-normal md:tracking-[0em]">
                        {introBold}
                    </SplitReveal>
                    <p class="font-radio text-mob-section leading-[120%] font-normal tracking-[0.03em] whitespace-pre-line md:text-main md:leading-[120%] md:font-light">
                        {introBody}
                    </p>
                </div>
            </div>
        )
    }

    <ContactFooter
        heading={t('contactFooterHeading')}
        paragraph={t('contactFooterParagraph')}
        mobBody={t('contactFooterMobBody')}
        lang={locale}
    />
</BaseLayout>

<style>
    /* The about image runs the full height of the text column beside it — from
       the top of the section label down to the perle rule under the button. So
       the column sets the height and the image fills it, rather than the image
       setting its own from an aspect ratio.

       CSS and not utilities, for two reasons. Astro emits a `<picture>` between
       the wrapper and the `<img>` that takes no class of ours and defaults to
       `display: inline`, so it would collapse the chain on its own. And the
       `[data-astro-image]` rules that come with `layout="full-width"` set
       `height: auto` at single-class specificity — the same as a utility, which
       leaves source order to decide it. The descendant selector here is one
       step more specific, so it settles.

       Below md the image keeps its drawn 267/343 ratio and none of this runs. */
    @media (min-width: 810px) {
        .about-media :global(picture) {
            display: block;
            height: 100%;
        }

        .about-media :global(img) {
            height: 100%;
            width: 100%;
            object-fit: cover;
        }
    }

    .hero-section {
        background: #1a1a1a;
    }

    .hero-slideshow {
        position: absolute;
        inset: 0;
        z-index: 0;
    }

    /* Five photos, four seconds each: a 20s cycle offset by 4s per slide. The
       photos are opaque and stacked, so each one only has to fade *out* to
       reveal the next; between the fades it sits at full opacity, which is why
       a slide waiting its turn stays visible under the ones above it. */
    .hero-slide {
        position: absolute;
        inset: 0;
        opacity: 1;
        animation: hero-fade var(--hero-cycle, 20s) ease-out infinite;
    }

    /* The titles run the same 20s cycle so each one is on screen exactly while
       its photo is. They cannot borrow the photos' trick, though — text is
       transparent, so a title waiting its turn would be legible over the title
       above it. It stays at `opacity: 0` until its turn (no fill mode, so the
       delay leaves this declaration standing) and fades in and out on its own.

       The `-1s` in the delay is what lines the two up: the fade-in occupies the
       first second of the animation, so starting a second early puts a title at
       full opacity for the same window its photo holds — and crossfades it with
       the outgoing title over the same second the photos crossfade. It also
       means the first title, at `-1s`, is already opaque on the first frame,
       leaving its entrance to the reveal bars. */
    .hero-title {
        opacity: 0;
        animation: hero-title-fade var(--hero-cycle, 20s) ease-out infinite;
    }

    :global(.hero-slide picture),
    :global(.hero-slide img) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    @keyframes hero-fade {
        0% {
            opacity: 1;
        }
        15% {
            opacity: 1;
        }
        20% {
            opacity: 0;
        }
        95% {
            opacity: 0;
        }
        100% {
            opacity: 1;
        }
    }

    /* 0-1s in, 1-4s held, 4-5s out, hidden for the remaining 15s. */
    @keyframes hero-title-fade {
