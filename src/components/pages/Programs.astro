---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import DashList from '@components/ui/DashList.astro';
import SanityPicture from '@components/ui/SanityPicture.astro';
import RevealHeader from '@components/sections/RevealHeader.astro';
import ContactFooter from '@components/sections/ContactFooter.astro';
import SplitReveal from '@components/sections/SplitReveal.astro';
import VideoSlider from '@components/sections/VideoSlider.astro';

import img6 from '@images/Tangible0797.jpg';
import img7 from '@images/LEADER.jpg';

import { localizedPath } from '@lib/i18n/utils';
import { pick, type I18nField } from '@lib/sanity/i18n';
import { getSiteSettings } from '@lib/sanity/queries';
import { muxSliderVideos } from '@lib/sanity/video';
import type { LocaleId } from '@lib/i18n/locales';

interface Props {
    data: Record<string, any> | null;
    locale: LocaleId;
}

const { data, locale } = Astro.props;
const t = (key: string) => pick(data?.[key] as I18nField, locale);

/** The films are global (Site Settings), not page content. */
const settings = await getSiteSettings();
const sliderVideos = muxSliderVideos(settings).map((video) => ({
    playbackId: video.playbackId,
    title: pick(video.title as I18nField, locale)
}));

const entreprisesFonts = ['formula', 'editorial'] as const;
const leadersFonts = ['formula', 'editorial'] as const;

const quote = t('quote');
const quoteAuthor = t('quoteAuthor');
---

<BaseLayout title={t('metaTitle')} description={t('metaDescription')}>
    <programs-animation style="display: contents;">
        <div class="programs-scroll-wrapper relative bg-offwhite">
            {
                /* The intro is the bottom of the stack: it holds its place while
                   card 1 rides up over it, so it lives inside the same wrapper as
                   the cards — that is what bounds how long it stays stuck. Mobile
                   keeps it in the flow, like the cards. */
            }
            <div
                class="programs-intro relative z-0 grid grid-cols-8 gap-mob-16 bg-offwhite px-page pt-nav-bottom md:sticky md:top-0 md:grid-cols-12 md:gap-gutter"
            >
                <div
                    class="col-span-8 flex flex-col gap-mob-16 py-mob-64 md:col-start-3 md:gap-main-40 md:px-main-60 md:py-main-80"
                >
                    <h1
                        class="text-mob-body leading-[120%] font-light tracking-[0.03em] text-bronze md:text-main-circle md:leading-[1.2] md:font-normal md:tracking-normal"
                    >
                        {t('pageTitle')}
                    </h1>
                    <p
                        class="text-mob-section leading-[120%] tracking-[0.03em] whitespace-pre-line md:text-main-body md:leading-[1.2]"
                    >
                        {t('pageIntro')}
                    </p>
                </div>
            </div>
            {
                /* Both bands stack title → list → button → image on mobile. Card 1
                draws the image first for the wide layout, so it is pushed last
                with `order`; card 2 is already in that order. The sticky scale
                is a desktop effect (its matchMedia starts at 810), so the
                positioning is scoped to md as well — otherwise the two cards
                pin over each other on a phone. */
            }
            <div
                class="programs-card programs-card-1 z-10 grid h-fit grid-cols-8 bg-perle px-page pb-mob-64 max-md:flex max-md:flex-col md:sticky md:top-nav-bottom md:grid-cols-12 md:gap-gutter md:py-main-80"
            >
                <div
                    class="col-span-8 flex overflow-clip max-md:order-2 max-md:mt-mob-32 max-md:px-mob-inset-inner md:col-span-4"
                >
                    <SanityPicture
                        image={data?.entreprisesImage}
                        fallback={img6}
                        {locale}
                        class="aspect-[267/367.43] object-cover md:aspect-444/611"
                        alt="Corporate Coaching"
                    />
                </div>
                <div
                    class="col-span-8 flex flex-col items-start gap-mob-32 max-md:contents md:gap-main-40 md:px-main-60"
                >
                    <div class="pt-mob-64 max-md:order-1 md:pt-0">
                        <RevealHeader
                            delay={0.25}
                            lines={[t('entreprisesTitle1'), t('entreprisesTitle2')].map(
                                (text, i) => ({
                                    text,
                                    font: entreprisesFonts[i]
                                })
                            )}
                        />
                    </div>

                    <div
                        class="flex w-full flex-col justify-start gap-mob-32 max-md:contents md:gap-main-100"
                    >
                        <DashList
                            text={t('entreprisesBody')}
                            markerClass="text-bronze"
                            class="text-mob-body leading-[120%] font-light tracking-[0.03em] max-md:order-3 max-md:px-mob-inset-inner max-md:pt-mob-32 md:text-main md:leading-[1.2]"
                        />
                        <div
                            class="flex w-full flex-row items-center justify-center max-md:order-4 max-md:pt-mob-32"
                        >
                            <Button
                                class="font-sans text-mob-section tracking-[0.03em] uppercase md:text-main-section"
                                href={localizedPath('/services/entreprises', locale)}
                                >{t('entreprisesButton')}</Button
                            >
                        </div>
                    </div>
                </div>
            </div>

            <div
                class="programs-card-2 z-20 grid h-fit grid-cols-8 bg-bronze px-page pb-mob-64 max-md:flex max-md:flex-col md:sticky md:top-0 md:grid-cols-12 md:gap-gutter md:py-main-80"
            >
                <div
                    class="col-span-8 flex flex-col items-start gap-mob-32 max-md:contents md:gap-main-40 md:px-main-60"
                >
                    <div class="col-span-8 flex w-full flex-col pt-mob-64 max-md:order-1 md:pt-0">
                        <RevealHeader
                            textColor={'#e1e3d0'}
                            lines={[t('leadersTitle1'), t('leadersTitle2')].map((text, i) => ({
                                text,
                                font: leadersFonts[i]
                            }))}
                        />
                    </div>
                    <div
                        class="col-span-6 col-start-2 flex w-full flex-col justify-end gap-0 max-md:contents"
                    >
                        <DashList
                            text={t('leadersBody')}
                            markerClass="text-perle"
                            class="text-mob-body leading-[120%] font-light tracking-[0.03em] max-md:order-3 max-md:px-mob-inset-inner max-md:pt-mob-32 md:text-main md:leading-[1.2]"
                        />
                        <div
                            class="flex w-full flex-row items-center justify-center pt-mob-32 max-md:order-4 md:pt-main-100"
                        >
                            <Button
                                class="text-mob-section tracking-[0.03em] uppercase md:text-main-section"
                                href={localizedPath('/services/leaders', locale)}
                                >{t('leadersButton')}</Button
                            >
                        </div>
                    </div>
                </div>
                <div
                    class="col-span-8 overflow-clip max-md:order-2 max-md:mt-mob-32 max-md:px-mob-inset-inner md:col-span-4"
                >
                    <SanityPicture
                        image={data?.leadersImage}
                        fallback={img7}
                        {locale}
                        class="aspect-[267/367.43] object-cover md:aspect-444/611"
                        alt="Leadership Coaching"
                    />
                </div>
            </div>

            <!-- ===============================================================
                 Films — a three-up slider, and the last floor of the stack. It
                 sits inside the wrapper rather than after it so that card 2 has
                 something to stay stuck against: a sticky element is released at
                 its container's bottom edge, so as the wrapper's final child card
                 2 had nowhere to travel and its `sticky` never took effect. With
                 the slider below it inside the same box, card 2 holds at the top
                 for the slider's whole height while it climbs over it — the same
                 exchange card 1 and card 2 already make one floor down.

                 `z-30` continues that ladder (intro 0, card 1 10, card 2 20), and
                 the section's own `bg-offwhite` is what does the covering.
                 =============================================================== -->
            <VideoSlider videos={sliderVideos} lang={locale} class="programs-video relative z-30" />
        </div>
    </programs-animation>

    <!-- ===================================================================
         Quote — bronze on perle, ruled top and bottom. The lines after the
         first hang 40px in, and the attribution starts just under halfway
         across the column; both are drawn that way in the frame, so they are
         expressed against the column rather than the page.
         =================================================================== -->
    {
        quote && (
            <div class="flex w-full flex-col justify-center bg-perle px-page pt-50.5 pb-76.5 md:aspect-1512/902 md:max-h-frame-902 md:py-main-40">
                <div class="grid grid-cols-8 gap-mob-16 md:grid-cols-12 md:gap-gutter">
                    <div class="col-span-8 flex flex-col gap-mob-32 border-y border-bronze py-mob-32 text-bronze md:col-span-10 md:col-start-2 md:gap-main-40 md:py-main-40">
                        <SplitReveal
                            hangingIndent="var(--hanging-indent)"
                            class="font-radio text-mob-md leading-[110%] font-normal [--hanging-indent:1.5rem] md:text-main-lead md:leading-[120%] md:[--hanging-indent:var(--spacing-main-40)]"
                        >
                            {quote}
                        </SplitReveal>

                        {quoteAuthor && (
                            <p class="pl-[45%] font-radio text-mob-body leading-[120%] font-light md:pl-[48%] md:text-main">
                                {quoteAuthor}
                            </p>
                        )}
                    </div>
                </div>
            </div>
        )
    }

    <script>
        import { gsap } from 'gsap';
        import { ScrollTrigger } from 'gsap/ScrollTrigger';
        gsap.registerPlugin(ScrollTrigger);

        class ProgramsAnimation extends HTMLElement {
            private mm: gsap.MatchMedia | undefined;

            connectedCallback() {
                const card1 = this.querySelector('.programs-card-1') as HTMLElement | null;
                const card2 = this.querySelector('.programs-card-2') as HTMLElement | null;
                const video = this.querySelector('.programs-video') as HTMLElement | null;

                if (card1 && card2) {
                    this.mm = gsap.matchMedia();

                    this.mm.add('(min-width: 810px)', () => {
                        /** Each floor recedes over the stretch the next one takes
                         *  to climb from its bottom edge to covering it outright.
                         *  The card is stuck by then, so its own height is the
                         *  distance from the top of the viewport to the edge the
                         *  climber has to clear. */
                        const recede = (card: HTMLElement, climber: HTMLElement) =>
                            gsap.to(card, {
                                scale: 0.8,
                                ease: 'power1.inOut',
                                scrollTrigger: {
                                    trigger: climber,
                                    start: () => `top ${card.offsetHeight}px`,
                                    end: 'top top',
                                    scrub: true,
                                    invalidateOnRefresh: true
                                }
                            });

                        /* Card 1 recedes only over the stretch where it is stuck at
                           the top and card 2 is climbing across it: from card 2's
                           top clearing card 1's bottom edge to it covering card 1
                           outright. Starting any earlier — the old `top bottom` —
                           had card 1 shrinking while it was itself still rising up
                           over the intro, which read as two moves at once. Running
                           it to `top top` rather than stopping halfway keeps the
                           recede going for as long as there is anything left to
                           see of it, instead of settling and then waiting. */
                        recede(card1, card2);

                        /* Card 2 makes the same exchange one floor up, with the
                           films as the climber. Guarded because the slider only
                           renders when Site Settings has films in it — with no
                           slider there is nothing to be covered by, so card 2
                           simply stays at full size as it always did. */
                        if (video) recede(card2, video);
                    });
                }
            }

            disconnectedCallback() {
                this.mm?.revert();
            }
        }

        if (!customElements.get('programs-animation')) {
            customElements.define('programs-animation', ProgramsAnimation);
        }
    </script>
    <ContactFooter
        heading={t('contactFooterHeading')}
        paragraph={t('contactFooterParagraph')}
        mobBody={t('contactFooterMobBody')}
        lang={locale}
    />
</BaseLayout>
