---
import SplitReveal from '@components/sections/SplitReveal.astro';
import ContactFooterForm from '@components/sections/ContactFooterForm.astro';
import { getSiteSettings } from '@lib/sanity/queries';
import { footerCopy, formCopy } from '@lib/content/siteCopy';
import type { LocaleId } from '@lib/i18n/locales';

interface Props {
    heading?: string;
    /** The paragraph beside the form on the wide layout. */
    paragraph?: string;
    /** The phone layout's single block, which runs the paragraph and the form heading together. */
    mobBody?: string;
    lang?: LocaleId;
}

const { lang = 'fr', heading, paragraph, mobBody } = Astro.props;

/**
 * The form labels in this band are authored under Site Settings — they read the
 * same on every page, so they are edited in one place rather than seven.
 *
 * The heading and the two paragraphs are the page's own, since each page closes
 * on something different. Each falls back to the shared copy under Site
 * Settings → Contact Footer when the page leaves it blank.
 */
const settings = await getSiteSettings();
const t = formCopy(settings, lang);
const footer = footerCopy(settings, lang);
const finalHeading = heading || footer.heading;
const finalParagraph = paragraph || footer.paragraph;
const finalMobBody = mobBody || footer.mobBody;

/**
 * Step two of the form: the last three field groups from the contact page, in
 * the same order. Built as data because the whole set is rendered twice — once
 * in the desktop layout and once in the mobile one.
 */
const step2Groups = [
    { name: 'employes', label: t.employeesLabel, options: t.employeesOptions },
    { name: 'budget', label: t.budgetLabel, options: t.budgetOptions },
    { name: 'accompagnement', label: t.supportLabel, options: t.supportOptions }
];

const labelClass =
    'block font-radio text-mob-section leading-[1.2] tracking-[0.02em] text-perle uppercase opacity-75 md:text-main-section';
const inputClass =
    'w-full border-b border-b-perle text-mob-body text-offwhite outline-0 md:text-main';
const optionClass =
    'flex cursor-pointer items-center gap-main-12 font-radio text-mob-section leading-[1.2] tracking-[0.02em] text-perle uppercase opacity-75 md:text-main-section';
const radioClass =
    'h-[calc(1.2em-4px)] w-[calc(1.2em-4px)] shrink-0 appearance-none rounded-full border border-perle bg-transparent outline-0 checked:bg-perle';
---

<contact-form
    style="display: contents;"
    data-btn-submit={t.submitText}
    data-btn-success={t.successText}
>
    {
        /* Tagged on each panel rather than on `<contact-form>`, which is
           `display: contents` and so has no box to measure. */
    }
    <div
        data-theme-color="#a29277"
        class="desktop-version grid w-full grid-cols-12 gap-gutter bg-bronze px-page pt-fluid-4xl pb-fluid-4xl"
    >
        <div
            class="col-span-10 col-start-2 flex flex-col justify-center gap-main-40 pt-fluid-lg pb-fluid-lg"
        >
            <SplitReveal
                class="font-radio text-footer-header leading-[110%] font-normal text-perle"
            >
                {finalHeading}
            </SplitReveal>

            <div class="grid grid-cols-2 gap-fluid-twenty">
                <SplitReveal
                    class="font-radio text-body-md leading-[120%] font-light tracking-[3%] text-perle"
                    tag="p"
                >
                    {finalParagraph}
                </SplitReveal>
                <div class="flex flex-col gap-fluid-twenty">
                    <h3
                        class="font-radio text-body-md leading-[120%] font-light tracking-[3%] text-perle"
                    >
                        {footer.booking}
                    </h3>
                    <ContactFooterForm
                        {t}
                        groups={step2Groups}
                        {labelClass}
                        {inputClass}
                        {optionClass}
                        {radioClass}
                    />
                </div>
            </div>
        </div>
    </div>
    <div
        data-theme-color="#a29277"
        class="mob-version flex flex-col gap-mob-64 bg-bronze px-mob-16 py-mob-64"
    >
        <SplitReveal
            class="px-mob-inset font-radio text-mob-footer leading-[105%] font-normal text-perle"
        >
            {finalHeading}
        </SplitReveal>
        {
            /* Authored with blank lines between paragraphs, like every other
            multi-paragraph field on the site — `whitespace-pre-line` renders
            them, so the copy no longer has to carry `<br />` tags. */
        }
        <SplitReveal
            class="font-radio text-mob-body leading-[120%] font-light tracking-[3%] whitespace-pre-line text-perle"
            tag="p"
        >
            {finalMobBody}
        </SplitReveal>
        <ContactFooterForm
            {t}
            groups={step2Groups}
            {labelClass}
            {inputClass}
            {optionClass}
            {radioClass}
        />
    </div>
</contact-form>

<script>
    import '@scripts/contactForm';
</script>
