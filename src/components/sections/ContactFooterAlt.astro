---
import Button from '@components/ui/Button.astro';
import SplitReveal from '@components/sections/SplitReveal.astro';
import { getSiteSettings } from '@lib/sanity/queries';
import { footerCopy, formCopy } from '@lib/content/siteCopy';
import { localizedPath } from '@lib/i18n/utils';
import type { LocaleId } from '@lib/i18n/locales';

interface Props {
    heading?: string;
    /** The paragraph beside the button on the wide layout. */
    paragraph?: string;
    /** The phone layout's single block, which runs the paragraph and the line under it together. */
    mobBody?: string;
    lang?: LocaleId;
}

const { lang = 'fr', heading, paragraph, mobBody } = Astro.props;

/**
 * Same arrangement as the full contact footer: the form labels are shared under
 * Site Settings, while the heading and the two paragraphs are the page's own and
 * fall back to the shared copy when left blank.
 */
const settings = await getSiteSettings();
const t = formCopy(settings, lang);
const footer = footerCopy(settings, lang);
const finalHeading = heading || footer.heading;
const finalParagraph = paragraph || footer.paragraph;
const finalMobBody = mobBody || footer.mobBody;
---

<contact-form
    style="display: contents;"
    data-btn-submit={t.submitText}
    data-btn-success={t.successText}
>
    {
        /* Tagged on each panel rather than on `<contact-form>`, which is
           `display: contents` and so has no box to measure. */
    }
    <div
        data-theme-color="#a29277"
        class="desktop-version grid aspect-1512/902 max-h-frame-902 w-full grid-cols-12 gap-gutter bg-bronze px-page pt-fluid-4xl pb-fluid-4xl"
    >
        <div
            class="col-span-10 col-start-2 flex flex-col justify-center gap-main-40 pt-fluid-lg pb-fluid-lg"
        >
            <SplitReveal class="font-radio text-footer-header leading-[110%] font-normal text-perle">
                {finalHeading}
            </SplitReveal>

            <div class="grid grid-cols-2 gap-gutter">
                <SplitReveal
                    class="font-radio text-body-md leading-[120%] font-light tracking-[3%] text-perle"
                    tag="p"
                >
                    {finalParagraph}
                </SplitReveal>
                <div class="flex h-full w-full flex-col items-end justify-end">
                    <Button href={localizedPath('/services', lang)}>{footer.cta}</Button>
                </div>
            </div>
        </div>
    </div>
    <div
        data-theme-color="#a29277"
        class="mob-version grid grid-cols-8 gap-x-mob-16 gap-y-mob-64 bg-bronze pt-mob-64 pr-mob-16 pb-mob-64 pl-mob-16"
    >
        <SplitReveal
            class="font-radio col-span-6 col-start-2 text-mob-footer leading-[105%] font-normal text-perle"
        >
            {finalHeading}
        </SplitReveal>
        <SplitReveal
            class="font-radio col-span-8 text-mob-body leading-[120%] font-light tracking-[3%] whitespace-pre-line text-perle"
            tag="p"
        >
            {finalMobBody}
        </SplitReveal>
        <form class="contact-form-inner col-span-8">
            <input type="hidden" name="access_key" value={t.accessKey} />
            <label
                for="name"
                class="font-radio block text-[0.875rem] tracking-[2%] text-perle uppercase opacity-75"
            >
                {t.nameLabel}
            </label>
            <input
                type="text"
                class="mb-5 w-full border-b border-b-perle pt-1 pb-1 text-mob-body text-offwhite outline-0"
                name="name"
                required
            />
            <label
                for="email"
                class="font-radio block text-[0.875rem] tracking-[2%] text-perle uppercase opacity-75"
            >
                {t.emailLabel}
            </label>
            <input
                type="email"
                name="email"
                class="mb-5 w-full border-b border-b-perle pt-1 pb-1 text-mob-body text-offwhite outline-0"
                required
            />
            <label
                for="phone"
                class="font-radio block text-[0.875rem] tracking-[2%] text-perle uppercase opacity-75"
            >
                {t.phoneLabel}
            </label>
            <input
                type="text"
                name="phone"
                class="mb-5 w-full border-b border-b-perle pt-1 pb-1 text-mob-body text-offwhite outline-0"
                required
            />
            <div class="flex flex-row justify-center pt-mob-16">
                <Button class="submit-btn" type="submit">{t.submitText}</Button>
            </div>
        </form>
    </div>
</contact-form>

<script>
    import '@scripts/contactForm';
</script>
