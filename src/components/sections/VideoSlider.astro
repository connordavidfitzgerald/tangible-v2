---
/**
 * A horizontal run of films, one visible at a time, paged by the arrows beneath
 * it. Drawn on DSK-Services_VideoSlider / MOB-Services_VideoSlider.
 *
 * The 1190px track in the frame is not an arbitrary inset — it is `col-start-2
 * col-span-10` of the page's 12-column grid at `px-main-40`, which resolves to
 * 1190.3px at 1512 with its left edge at 161.3px. So the column is expressed as
 * grid placement rather than a hard-coded percentage, and it stays locked to
 * every other section's gutters as the viewport moves.
 *
 * Slides are 16:9 at both breakpoints (1190×669 and 267×150), so one aspect
 * ratio covers the lot.
 */
import { Icon } from 'astro-icon/components';
import MuxVideo from '@components/ui/MuxVideo.astro';
import { getSiteSettings } from '@lib/sanity/queries';
import { copy } from '@lib/content/siteCopy';
import type { LocaleId } from '@lib/i18n/locales';

interface Props {
    videos: { playbackId: string; title?: string }[];
    class?: string;
    /** Labels the arrow buttons; the films themselves carry their own titles. */
    lang?: LocaleId;
}

const { videos, class: className, lang = 'fr' } = Astro.props;

const settings = await getSiteSettings();
const labels = {
    prev: copy(settings, 'videoPrevLabel', lang),
    next: copy(settings, 'videoNextLabel', lang)
};
---

{
    videos.length > 0 && (
        <video-slider
            class:list={[
                'video-slider block w-full overflow-hidden bg-offwhite pt-mob-128 pb-mob-64 md:py-main-100',
                className
            ]}
        >
            <div class="grid grid-cols-8 gap-mob-16 px-mob-inset md:grid-cols-12 md:gap-gutter md:px-page">
                {/* The column sizes the current film — 8 of 8 on mobile, the
                    middle 10 of 12 at md — but does not clip. The track spills
                    past it so the next film shows from column 12 onward, cut
                    off by the section's own overflow at the page edge. Which
                    means the gap has to be the grid's own gutter: anything else
                    and the next film stops landing on a column boundary. */}
                <div class="col-span-8 md:col-span-10 md:col-start-2">
                    {/* Paged by translating the track, so the slides stay in flow
                        and keep their own height rather than being absolutely
                        positioned against a guessed one. */}
                    {/* `relative` so the track is the slides' offsetParent — the
                        paging below reads `offsetLeft`, which is measured from
                        there. Without it the offsets are page coordinates and
                        include the section's own padding, which drags the first
                        film out of its column and flush against the page edge. */}
                    <div class="vs-track relative flex w-full flex-row gap-mob-16 md:gap-gutter">
                        {/* Every film plays while it is the current one, which
                            `autoplayInView` gives for free rather than needing
                            the paging below to drive play/pause itself.

                            The observer it turns on watches each slide's own box
                            against the section's `overflow-hidden`, and this
                            slider pages by translating slides through a clipped
                            column — so "enough of it is on screen" and "it is the
                            current one" are the same question here. The margin is
                            comfortable: the next film peeks about 12% of itself
                            past the column at 1512 and essentially nothing on
                            mobile, both well under the 35% the observer wants.
                            So arriving at the section starts the current film,
                            paging starts the one you land on, and the one you
                            left falls under the threshold and pauses.

                            They play muted, which is not a choice — browsers
                            block sound-on autoplay outright, so `MuxVideo` folds
                            `autoplayInView` into `muted` rather than letting the
                            play attempt fail and leave a stopped film. */}
                        {videos.map((video, i) => (
                            <div class="vs-slide w-full shrink-0" data-index={i}>
                                <MuxVideo
                                    playbackId={video.playbackId}
                                    title={video.title}
                                    class="aspect-video w-full"
                                    autoplayInView
                                />
                            </div>
                        ))}
                    </div>
                </div>

                {videos.length > 1 && (
                    <div class="col-span-8 flex flex-row justify-between pt-mob-32 md:col-span-10 md:col-start-2 md:pt-main-40">
                        <button
                            type="button"
                            class="vs-prev cursor-pointer border-0 bg-transparent p-0"
                            aria-label={labels.prev}
                        >
                            <Icon name="leftarrow" class="h-[1.875rem] w-auto md:h-fluid-forty" />
                        </button>
                        <button
                            type="button"
                            class="vs-next cursor-pointer border-0 bg-transparent p-0"
                            aria-label={labels.next}
                        >
                            <Icon name="rightarrow" class="h-[1.875rem] w-auto md:h-fluid-forty" />
                        </button>
                    </div>
                )}
            </div>
        </video-slider>
    )
}

<script>
    import gsap from 'gsap';
    import { MUTE_CHANGE_EVENT } from '@components/ui/VideoControls';

    /** The slice of `<video-controls>` this slider drives. See `setCurrent` there. */
    type VideoControlsElement = HTMLElement & {
        setCurrent?: (current: boolean, withSound?: boolean) => void;
    };

    class VideoSlider extends HTMLElement {
        private ctx: gsap.Context | undefined;

        connectedCallback() {
            this.ctx = gsap.context(() => {
                const track = this.querySelector<HTMLElement>('.vs-track');
                const slides = [...this.querySelectorAll<HTMLElement>('.vs-slide')];
                const prev = this.querySelector<HTMLElement>('.vs-prev');
                const next = this.querySelector<HTMLElement>('.vs-next');
                if (!track || slides.length < 2) return;

                let index = 0;

                /**
                 * Read the offset off the DOM rather than computing slide width
                 * plus gap: both are fluid tokens, so the browser's number is
                 * the only one guaranteed to stay right through a resize.
                 */
                const offsetFor = (i: number) => -slides[i].offsetLeft;

                const controlsFor = (i: number) =>
                    slides[i]?.querySelector<VideoControlsElement>('video-controls');

                /**
                 * Whether the films may play with sound.
                 *
                 * False on arrival, because nothing else is possible: the first
                 * film starts from an IntersectionObserver rather than a gesture,
                 * and browsers only ever grant muted autoplay to that. Working an
                 * arrow *is* a gesture, so from the first page onwards sound is
                 * allowed, and the viewer's own mute button then has the last word
                 * — see the listener below.
                 */
                let soundArmed = false;

                const goTo = (i: number, animate = true) => {
                    const from = index;
                    index = (i + slides.length) % slides.length;
                    gsap.to(track, {
                        x: offsetFor(index),
                        duration: animate ? 0.75 : 0,
                        ease: 'power3.inOut'
                    });

                    // A resize re-pins the same slide; nothing has changed hands.
                    if (index === from) return;

                    /* Both calls are deliberately synchronous with the click that
                       got here, and deliberately ahead of the slide travelling.
                       The incoming film's unmuted `play()` only counts while the
                       gesture is live, so it cannot wait for the 0.75s translate
                       to land — and the outgoing one has to stop on the same frame
                       rather than when it clears the column, or the two would be
                       audible over each other for most of the transition. */
                    controlsFor(from)?.setCurrent?.(false);
                    controlsFor(index)?.setCurrent?.(true, soundArmed);
                };

                const page = (to: number) => {
                    soundArmed = true;
                    goTo(to);
                };

                prev?.addEventListener('click', () => page(index - 1));
                next?.addEventListener('click', () => page(index + 1));

                // The mute button outranks the arming above, in both directions:
                // muting a film keeps the next one silent too, and unmuting turns
                // sound back on for the rest of the run. Whatever the viewer last
                // said about sound is what the film they page to does.
                this.addEventListener(MUTE_CHANGE_EVENT, (event) => {
                    soundArmed = !(event as CustomEvent<{ muted: boolean }>).detail.muted;
                });

                // Slide widths are viewport-derived, so a resize invalidates the
                // current translation. Re-pin without animating.
                const observer = new ResizeObserver(() => goTo(index, false));
                observer.observe(this);

                return () => observer.disconnect();
            }, this);
        }

        disconnectedCallback() {
            this.ctx?.revert();
        }
    }

    if (!customElements.get('video-slider')) {
        customElements.define('video-slider', VideoSlider);
    }
</script>
